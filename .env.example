# Lead capture (POST /api/leads). Leave unset in dev: submissions are logged to
# the server console. Set to an Airtable/Zapier/Make/Slack webhook in production.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Paystack (server-side only — never expose the secret key to the browser).
# Get keys from https://dashboard.paystack.com/#/settings/developer and add the
# webhook URL https://<your-domain>/api/webhooks/paystack there too. Checkout
# returns 503 until PAYSTACK_SECRET_KEY is set.
PAYSTACK_SECRET_KEY=
# Test-only override for the Paystack API host; leave blank in production.
PAYSTACK_API_BASE=

# Order records (checkout + payment confirmations). Same pattern as the leads
# webhook: unset means the records are logged instead.
ORDERS_WEBHOOK_URL=
ORDERS_WEBHOOK_TOKEN=
